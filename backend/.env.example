# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The backend reads these at startup via app/core/settings.py

# Runtime mode: set to 0 for production
DEBUG=1

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# SQLite database path (auto-created, do not commit)
# DATABASE_URL=sqlite:///./data/csllm.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (requests per minute per IP, 0 = disabled in dev)
RATE_LIMIT_PER_MINUTE=60

# Max request body size in bytes (default 1 MiB)
MAX_BODY_SIZE_BYTES=1048576

# Ollama request timeout in seconds
OLLAMA_TIMEOUT=30

# RAG (Retrieval-Augmented Generation)
RAG_ENABLED=true
RAG_INIT_MODE=lazy        # off | lazy | background

# Vider toutes les données au démarrage (utile pour repartir d'une DB propre)
# Mettre à true pour effacer alertes/incidents/défense à chaque restart
CLEAR_DB_ON_START=false

# GeoIP (optional — place GeoLite2-City.mmdb in backend/data/)
# GEOLITE2_CITY_DB=./data/GeoLite2-City.mmdb
